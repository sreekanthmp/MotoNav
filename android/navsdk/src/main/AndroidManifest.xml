<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The service the Navigation SDK binds to (registerServiceForNavUpdates). It runs in the
         app's own process and is not exported: only the SDK, which is in the same process, binds it. -->
    <application>
        <service
            android:name=".NavUpdatesService"
            android:exported="false" />
    </application>
</manifest>
