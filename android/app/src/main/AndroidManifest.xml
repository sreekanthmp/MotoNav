<?xml version="1.0" encoding="utf-8"?>
<!--
  Permissions follow https://developer.android.com/develop/connectivity/bluetooth/bt-permissions

  Android 12 (API 31) and higher: BLUETOOTH_SCAN to find the device, BLUETOOTH_CONNECT to talk
  to it. The app never uses scan results to work out where the user is, so BLUETOOTH_SCAN is
  declared neverForLocation and no location permission is needed.

  Android 11 (API 30) and lower: the legacy permissions, plus location, which those versions
  require for a Bluetooth scan.

  Location (Phase 4): the Navigation SDK needs ACCESS_FINE_LOCATION on EVERY Android version to
  navigate. It is therefore declared without a maxSdkVersion. (With "maxSdkVersion=30" the merged
  manifest lost the permission on Android 12 and later and navigation could not start: found by
  reading the merged manifest, and a test now guards it.) The BLE scan is still declared
  neverForLocation: the app does not derive its position from scan results.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- usesPermissionFlags exists from Android 12; older versions ignore it, and they use the
         location permission declared above instead. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:ignore="UnusedAttribute" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Backups would copy the app's data off the phone. The app stores nothing (road names must
         never be persisted, DECISIONS.md D-05), so there is nothing to back up. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_launcher"
        android:label="MotoNav"
        android:theme="@android:style/Theme.DeviceDefault.Light">

        <!-- The Navigation SDK reads its API key from here. The value comes from a Gradle
             placeholder and is never in the source. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
